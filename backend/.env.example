DEBUG=True
SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/safariquest
# sqlite:///db.sqlite3 also works if you don't have Postgres running locally
CORS_ALLOWED_ORIGINS=http://localhost:5173
# use None (requires HTTPS/Secure cookies) if frontend and API are on different registrable domains
AUTH_COOKIE_SAMESITE=Lax
FRONTEND_URL=http://localhost:5173

# Number of trusted reverse proxies in front of the API. Leave unset locally.
# Set to 1 on Railway (or any proxied host): without it DRF rate-limits on the
# proxy's IP, so every visitor shares one bucket.
# NUM_PROXIES=1

# Extra origins allowed to make unsafe (POST/PATCH/DELETE) requests. The origin
# of FRONTEND_URL is trusted automatically, so this is only for additional clients.
# CSRF_TRUSTED_ORIGINS=

# Email. Unset EMAIL_HOST (the default) uses the console backend and prints
# messages to stdout. Setting it switches to real SMTP. With DEBUG=False and
# neither EMAIL_HOST nor an explicit EMAIL_BACKEND, startup refuses to proceed
# rather than dropping invite and quote emails silently.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=SafariQuest <no-reply@example.com>

# HTTPS hardening, applied when DEBUG=False. SECURE_SSL_REDIRECT additionally
# needs NUM_PROXIES set. HSTS is off by default because it cannot be undone
# before max-age expires.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=0

# Optional: only needed to use S3/MinIO for uploaded images locally.
# Unset (the default) uses local disk storage under MEDIA_ROOT instead.
# AWS_STORAGE_BUCKET_NAME=safariquest-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_S3_CUSTOM_DOMAIN=localhost:9000/safariquest-media

# Snippe payments (mobile money hosted checkout, TZS). Without SNIPPE_API_KEY
# the pay endpoints return 503. SNIPPE_API_KEY needs collection:create;
# SNIPPE_READ_API_KEY needs collection:read (leave it unset if one key has both).
# No disbursement scopes are needed. The webhook secret is under Settings → Webhook Secret in
# the Snippe dashboard. SNIPPE_WEBHOOK_URL must be public HTTPS ending in
# /api/payments/snippe/webhook/ — use an ngrok URL when running locally.
# SNIPPE_API_KEY=snp_...
# SNIPPE_READ_API_KEY=snp_...
# SNIPPE_WEBHOOK_SECRET=whsec_...
# SNIPPE_WEBHOOK_URL=https://your-api.example.com/api/payments/snippe/webhook/
# SNIPPE_PROFILE_ID=
# SNIPPE_API_URL=https://api.snippe.sh
# SNIPPE_SESSION_EXPIRES_IN=3600
# direct (default): tourists enter their phone number on this site and approve
# the prompt Snippe sends to it. hosted: send them to Snippe's checkout page.
# SNIPPE_CHECKOUT_MODE=direct
# Run `manage.py reconcile_snippe_payments` every ~5 minutes (e.g. a Railway
# cron service): it confirms open payments with Snippe directly, so a payment
# still lands if Snippe's webhook never arrives.

# Snippe outage notices, read by `manage.py check_snippe_outages` (run it every
# ~10 minutes, e.g. as a Railway cron service). Point it at the mailbox Snippe
# emails; for Gmail use imap.gmail.com and an App Password. Leave the host unset
# to check only Snippe's status page. SENDER_DOMAINS must match the domain in
# Snippe's From address.
# SNIPPE_NOTICES_IMAP_HOST=imap.gmail.com
# SNIPPE_NOTICES_IMAP_USER=you@example.com
# SNIPPE_NOTICES_IMAP_PASSWORD=
# SNIPPE_NOTICES_IMAP_FOLDER=INBOX
# SNIPPE_NOTICES_SENDER_DOMAINS=snippe.sh
# SNIPPE_NOTICES_REQUIRE_DKIM=True
# Warn about a network when this many payments on it fail (excluding declined
# prompts, wrong PINs, low balance) within the window, across at least
# MIN_PAYMENTS different payments, with no success in between.
# SNIPPE_FAILURE_THRESHOLD=3
# SNIPPE_FAILURE_WINDOW_MINUTES=30
# SNIPPE_FAILURE_MIN_PAYMENTS=2

# Read only by `manage.py seed_admin`, not at server startup. Creates (or
# updates) a single admin user — idempotent, safe to re-run on every deploy.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=
